    @keyframes float { 0%,100%{transform:translateY(-50%) rotate(-3deg)}50%{transform:translateY(-52%) rotate(3deg)} }
    .tag { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--red); border: 1px solid var(--red); padding: 6px 14px; border-radius: 2px; margin-bottom: 32px; width: fit-content; animation: fadeUp 0.6s ease both; }
    h1 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(72px,18vw,180px); line-height: 0.9; animation: fadeUp 0.7s 0.1s ease both; }
    h1 span { color: var(--red); display: block; }
    .subtitle { font-size: clamp(16px,3vw,22px); font-weight: 300; color: #aaa; max-width: 520px; line-height: 1.6; margin-top: 28px; animation: fadeUp 0.7s 0.2s ease both; }
    .subtitle strong { color: var(--white); font-weight: 600; }
    .cta-wrap { margin-top: 48px; animation: fadeUp 0.7s 0.3s ease both; }
    .cta-btn { display: inline-flex; align-items: center; gap: 12px; background: #25D366; color: #000; font-family: 'DM Sans', sans-serif; font-size: 17px; font-weight: 700; padding: 18px 36px; border-radius: 4px; text-decoration: none; }
    .cta-btn svg { width: 22px; height: 22px; flex-shrink: 0; }
    .cta-note { margin-top: 14px; font-size: 13px; color: var(--muted); }
    .divider { height: 1px; background: linear-gradient(90deg, transparent, #333, transparent); margin: 0 24px; }
    .stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: #1f1f1f; margin: 60px 0; }
    .stat { background: var(--black); padding: 36px 24px; text-align: center; opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease, transform 0.5s ease; }
    .stat.visible { opacity: 1; transform: translateY(0); }
    .stat-num { font-family: 'Bebas Neue', sans-serif; font-size: clamp(36px,8vw,64px); color: var(--red); line-height: 1; }
    .stat-label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 8px; }
    .section { padding: 60px 24px; }
    .section-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(36px,8vw,72px); line-height: 1; margin-bottom: 40px; }
    .section-title span { color: var(--red); }
    .reasons { display: flex; flex-direction: column; gap: 2px; }
    .reason { background: var(--grey); padding: 24px; display: flex; align-items: flex-start; gap: 20px; border-left: 3px solid transparent; opacity: 0; transform: translateX(-20px); transition: opacity 0.4s ease, transform 0.4s ease, border-color 0.3s, background 0.3s; }
    .reason.visible { opacity: 1; transform: translateX(0); }
    .reason:hover { border-left-color: var(--red); background: #222; }
    .reason-num { font-family: 'Bebas Neue', sans-serif; font-size: 32px; color: var(--red); opacity: 0.5; min-width: 40px; line-height: 1; }
    .reason-content h3 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
    .reason-content p { font-size: 14px; color: #888; line-height: 1.5; }
    .quote-section { padding: 60px 24px; border-top: 1px solid #1f1f1f; border-bottom: 1px solid #1f1f1f; }
    blockquote { font-family: 'Bebas Neue', sans-serif; font-size: clamp(28px,7vw,56px); line-height: 1.1; color: var(--white); padding-left: 24px; border-left: 4px solid var(--red); }
    blockquote span { color: var(--red); }
    .quote-author { margin-top: 20px; font-size: 13px; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; }
    .final-cta { padding: 80px 24px; text-align: center; }
    .final-cta h2 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(48px,12vw,100px); line-height: 0.95; margin-bottom: 24px; }
    .final-cta h2 span { color: var(--red); }
    .final-cta p { font-size: 16px; color: #888; max-width: 400px; margin: 0 auto 40px; line-height: 1.6; }
    footer { padding: 24px; text-align: center; font-size: 12px; color: #444; border-top: 1px solid #1a1a1a; }
    footer a { color: var(--red); text-decoration: none; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)} }
    @media (max-width: 480px) { .stat { padding: 24px 12px; } .stat-label { font-size: 10px; } }
  </style>
